{service=~"auth|blog|notification"} | json | line_format "\x1b[90m{{ .time | substr 11 23 }}\x1b[0m {{ if eq .level \"error\" }}\x1b[1;31m{{ else if eq .level \"warn\" }}\x1b[1;33m{{ else }}\x1b[90m{{ end }}{{ printf \"%-5s\" (.level | ToUpper) }}\x1b[0m \x1b[35m{{ printf \"%-12s\" .service }}\x1b[0m \x1b[1m{{ .msg }}\x1b[0m{{ if .path }} \x1b[1;36m{{ .method }}\x1b[0m \x1b[94m{{ .path }}\x1b[0m -> {{ .status }}{{ end }}{{ if .took }} \x1b[90m{{ .took }}\x1b[0m{{ end }}{{ if .request_id }} \x1b[32mreq={{ .request_id }}\x1b[0m{{ end }}{{ if .user_id }} \x1b[32muser={{ .user_id }}\x1b[0m{{ end }}{{ if .event_id }} \x1b[32mevent={{ .event_id }}\x1b[0m{{ end }}{{ if .error_code }} \x1b[1;31m[{{ .error_code }}]\x1b[0m{{ end }}"
