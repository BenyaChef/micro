# Открытые настройки auth. Секретов здесь быть не должно:
# всё из этого файла попадает в ConfigMap и видно в описании пода.

ENVIRONMENT=production

# Service
LOG_LEVEL=info

# REST и gRPC
REST_PORT=8081
GRPC_PORT=9091

# Metrics
METRICS_PORT=9101

# Postgres
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# JWT
JWT_TTL=1h

# Пароли
PASSWORD_HASH_COST=10

# Kafka
KAFKA_BROKERS=kafka:9092
