# Открытые настройки blog. Секретов здесь быть не должно:
# всё из этого файла попадает в ConfigMap и видно в описании пода.

ENVIRONMENT=production

# Service
LOG_LEVEL=info

# REST
REST_PORT=8082

# Metrics
METRICS_PORT=9102

# Postgres
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# Auth (gRPC)
AUTH_GRPC_ADDR=auth-micro:9091
